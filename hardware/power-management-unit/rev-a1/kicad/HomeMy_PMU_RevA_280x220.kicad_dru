(version 1)
# Only intrinsic same-package pad spacing uses 0.15 mm; routes retain the 0.20 mm netclass clearance.
(rule "Reviewed fine-pitch land pattern U1"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U1') && B.memberOfFootprint('U1')")
  (constraint clearance (min 0.15mm)))
(rule "Reviewed fine-pitch land pattern U2"
