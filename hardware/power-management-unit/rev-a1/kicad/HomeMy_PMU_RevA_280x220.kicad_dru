# High-current rules: netclass defaults alone are NOT DRC minimums.
(rule "PWR_BATTERY power copper"
  (condition "A.hasNetclass('PWR_BATTERY')")
  (constraint track_width (min 4mm) (opt 6mm)))
(rule "PWR_BATTERY outer power connections"
  (layer outer)
  (condition "A.hasNetclass('PWR_BATTERY')")
  (constraint connection_width (min 1.0mm)))
(rule "PWR_BATTERY power vias"
  (condition "A.Type == 'Via' && A.hasNetclass('PWR_BATTERY')")
  (constraint via_diameter (min 0.8mm))
  (constraint hole_size (min 0.4mm)))
(rule "PWR_SYS power copper"
  (condition "A.hasNetclass('PWR_SYS')")
  (constraint track_width (min 4mm) (opt 6mm)))
(rule "PWR_SYS outer power connections"
  (layer outer)
  (condition "A.hasNetclass('PWR_SYS')")
  (constraint connection_width (min 1.0mm)))
(rule "PWR_SYS power vias"
  (condition "A.Type == 'Via' && A.hasNetclass('PWR_SYS')")
  (constraint via_diameter (min 0.8mm))
  (constraint hole_size (min 0.4mm)))
(rule "PWR_MOTION power copper"
  (condition "A.hasNetclass('PWR_MOTION')")
  (constraint track_width (min 4mm) (opt 6mm)))
(rule "PWR_MOTION outer power connections"
  (layer outer)
  (condition "A.hasNetclass('PWR_MOTION')")
  (constraint connection_width (min 1.0mm)))
(rule "PWR_MOTION power vias"
  (condition "A.Type == 'Via' && A.hasNetclass('PWR_MOTION')")
  (constraint via_diameter (min 0.8mm))
  (constraint hole_size (min 0.4mm)))
(rule "PWR_ARM power copper"
  (condition "A.hasNetclass('PWR_ARM')")
  (constraint track_width (min 6mm) (opt 6mm)))
(rule "PWR_ARM outer power connections"
  (layer outer)
  (condition "A.hasNetclass('PWR_ARM')")
  (constraint connection_width (min 1.0mm)))
(rule "PWR_ARM power vias"
  (condition "A.Type == 'Via' && A.hasNetclass('PWR_ARM')")
  (constraint via_diameter (min 0.8mm))
  (constraint hole_size (min 0.4mm)))
(rule "Reviewed PWR_TAP_CONTROL"
  (condition "A.memberOfGroup('PWR_TAP_CONTROL')")
  (constraint track_width (min 0.2mm))
  (constraint connection_width (min 0.2mm))
  (constraint via_diameter (min 0.6mm))
  (constraint hole_size (min 0.3mm)))
(rule "Reviewed PWR_SYS_BRANCH_SPINE"
  (condition "A.memberOfGroup('PWR_SYS_BRANCH_SPINE')")
  (constraint track_width (min 0.8mm))
  (constraint connection_width (min 0.8mm))
  (constraint via_diameter (min 0.6mm))
  (constraint hole_size (min 0.3mm)))
(rule "Reviewed PWR_SYS_BRANCH_FANOUT"
  (condition "A.memberOfGroup('PWR_SYS_BRANCH_FANOUT')")
  (constraint track_width (min 0.25mm))
  (constraint connection_width (min 0.25mm))
  (constraint via_diameter (min 0.6mm))
  (constraint hole_size (min 0.3mm)))
(rule "Bias/reference pad neck R11"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('R11') && (A.hasNetclass('PWR_BATTERY') || A.hasNetclass('PWR_SYS') || A.hasNetclass('PWR_MOTION') || A.hasNetclass('PWR_ARM'))")
  (constraint connection_width (min 0.2mm)))
(rule "Bias/reference pad neck R12"
