<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>homemy_state_estimation</name>
  <version>0.1.0</version>
  <description>
    State estimation of HomeMy: a read-only reader for the HWT601-AGV-485 IMU
    (Modbus RTU, function 0x03 only), ported from the Amadeus
    robot_state_estimation package, and a yaw-rate aid that learns the gyro
    bias at standstill. Fusing the yaw rate into the odometry is opt-in.
  </description>
  <maintainer email="homemy@example.com">HomeMy</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
