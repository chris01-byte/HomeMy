<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>homemy_lidar_bringup</name>
  <version>0.1.0</version>
  <description>
    STL-27L scan handling for HomeMy: masks the six blind sectors behind the
    struts and slot webs. The driver and scan normalisation follow after
    LiDAR commissioning.
  </description>
  <maintainer email="homemy@example.com">HomeMy</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-numpy</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
