<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>homemy_simulation</name>
  <version>0.1.0</version>
  <description>
    HomeMy test stand and simulation stand-ins: a floor-plan world with the
    simulated drive, LiDAR, odometry, and IMU (ported from the Amadeus test
    stand), a simulated controller and operator, and a synthetic map.
    Simulation only; never start these on the robot.
  </description>
  <maintainer email="homemy@example.com">HomeMy</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>homemy_description</test_depend>
  <test_depend>homemy_lidar_bringup</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
