<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>homemy_simulation</name>
  <version>0.1.0</version>
  <description>
    Simulation stand-ins for HomeMy hardware and services: a synthetic map that
    grows while mapping, a simulated controller, and a lifecycle state stub.
    Simulation only; never start these on the robot.
  </description>
  <maintainer email="homemy@example.com">HomeMy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
