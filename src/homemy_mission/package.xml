<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>homemy_mission</name>
  <version>0.1.0</version>
  <description>
    Mission manager of HomeMy: "drive to a room" and "cancel" from the app,
    with preconditions, bounded retries, and a drive-active signal for the
    motion gate. Room goals are resolved with the room-goal code ported from
    Amadeus.
  </description>
  <maintainer email="homemy@example.com">HomeMy</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <exec_depend>homemy_navigation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
